  {
    "name": "legacy message defaults",
    "operation": "download",
    "input": {
      "type": "DIRECT_DOWNLOAD"
    },
    "expectedSubset": {
      "urls": [],
      "imageMode": false,
      "downloadAll": false,
      "transferTimeoutMs": 2500,
      "contractVersion": 1,
      "namingUrl": null
    }
  },
  {
    "name": "source identity stays distinct",
    "operation": "download",
    "input": {
      "type": "DIRECT_DOWNLOAD",
      "urls": [
        "https://media.example/b.mp4",
        "https://media.example/a.mp4",
        "https://media.example/b.mp4"
      ],
      "fallbackSourceUrl": "https://scrolller.com/",
      "scrolllerSourceUrl": "https://scrolller.com/chosen",
      "namingUrl": "https://media.example/original.gif",
      "futureField": "kept"
    },
    "expectedSubset": {
      "urls": [
        "https://media.example/b.mp4",
        "https://media.example/a.mp4",
        "https://media.example/b.mp4"
      ],
      "fallbackSourceUrl": "https://scrolller.com/",
      "scrolllerSourceUrl": "https://scrolller.com/chosen",
      "namingUrl": "https://media.example/original.gif",
      "futureField": "kept"
    }
  },
  {
    "name": "explicit settings retained",
    "operation": "download",
    "input": {
      "type": "DIRECT_DOWNLOAD",
      "imageMode": true,
      "downloadAll": true,
      "transferTimeoutMs": 900,
      "site": "RedGifs",
      "allowRipsnipFallback": false
    },
    "expectedSubset": {
      "imageMode": true,
      "downloadAll": true,
      "transferTimeoutMs": 900,
      "site": "RedGifs",
      "allowRipsnipFallback": false
    }
  },
