[
  {
    "name": "image before thumbnail",
    "operation": "scrolller",
    "input": "<img src=\"https://media.example/thumb.webp\"><meta property=\"og:image\" content=\"https://media.example/original.jpg\">",
    "expected": [
      "https://media.example/original.jpg",
      "https://media.example/thumb.webp"
    ]
  },
  {
    "name": "video before poster",
    "operation": "scrolller",
    "input": "<meta property=\"og:image\" content=\"https://media.example/poster.jpg\"><meta property=\"og:video\" content=\"https://photon.scrolller.com/movie.mp4\">",
    "expected": [
      "https://photon.scrolller.com/movie.mp4",
      "https://media.example/poster.jpg"
    ]
  },
  {
    "name": "GIF stays GIF",
    "operation": "scrolller",
    "input": "<meta property=\"og:image\" content=\"https://media.example/clip.gif\"><video src=\"https://photon.scrolller.com/clip.mp4\"></video>",
    "expected": [
      "https://media.example/clip.gif",
      "https://photon.scrolller.com/clip.mp4"
    ]
  },
  {
    "name": "escaped duplicate",
    "operation": "scrolller",
    "input": "<meta property=\"og:video\" content=\"https:\\u002f\\u002fphoton.scrolller.com\\u002fmovie.mp4?a=1&amp;b=2\"><video src=\"https://photon.scrolller.com/movie.mp4?a=1&amp;b=2\"></video>",
    "expected": [
      "https://photon.scrolller.com/movie.mp4?a=1&b=2"
    ]
  },
  {
    "name": "empty source",
    "operation": "scrolller",
    "input": "",
    "expected": []
  },
