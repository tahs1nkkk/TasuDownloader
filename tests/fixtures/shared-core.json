  {
    "name": "site subdomain",
    "operation": "siteForHost",
    "input": "OLD.REDDIT.COM",
    "expected": "Reddit"
  },
  {
    "name": "spoofed site",
    "operation": "siteForHost",
    "input": "reddit.com.example.org",
    "expected": "Other"
