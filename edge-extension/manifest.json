{
  "manifest_version": 3,
  "name": "Tasu Apps",
  "version": "0.31.7",
  "description": "Tasu Apps: Downloader, Roblox Friend Tracker, Dada Review and local music tools.",
  "optional_permissions": [
    "notifications",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "https://*.roblox.com/*"
  ],
  "permissions": [
    "activeTab",
    "tabs",
    "downloads",
    "scripting",
    "clipboardRead",
    "clipboardWrite",
    "storage",
    "declarativeNetRequestWithHostAccess",
    "alarms"
  ],
  "host_permissions": [
    "https://redgifs.com/*",
    "https://*.redgifs.com/*",
    "https://ripsnip.com/*",
    "https://www.ripsnip.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://redgifs.com/*",
        "https://*.redgifs.com/*"
      ],
      "js": [
        "page-hook-redgifs.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://redgifs.com/*",
        "https://*.redgifs.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-folders.js",
        "content-redgifs.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://reddit.com/*",
        "https://www.reddit.com/*",
        "https://new.reddit.com/*",
        "https://old.reddit.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-folders.js",
        "content-reddit.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://scrolller.com/*",
        "https://www.scrolller.com/*",
        "https://*.scrolller.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-folders.js",
        "content-scrolller-v2.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://coomer.st/*",
        "https://www.coomer.st/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-coomer.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://onlyfans.com/*",
        "https://www.onlyfans.com/*"
      ],
      "js": [
        "page-hook-onlyfans.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://onlyfans.com/*",
        "https://www.onlyfans.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-onlyfans.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "common/weblink.js",
        "content-folders.js",
        "content-instagram.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://ripsnip.com/*",
        "https://www.ripsnip.com/*"
      ],
      "js": [
        "common/sites.js",
        "common/settings.js",
        "common/media-rules.js",
        "common/download-contract.js",
        "common/version.js",
        "common/lifecycle.js",
        "common/ui.js",
        "content-ripsnip.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Tasu Apps",
    "default_popup": "hub.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png",
      "48": "icon-48.png",
      "128": "icon-128.png"
    }
  }
}
